# =============================================================
# .env.embr.example — Reference values for Embr `run.env`
#
# This file is NOT loaded by Embr at deploy time. Embr reads
# runtime environment variables from the service's `run.env`
# map. Set them with ONE of the following:
#
# 1) Embr CLI (recommended — scriptable):
#
#      embr variables set -p <projectId> -e <envId> \
#          --key ELASTICSEARCH_URL --value "https://..."
#      embr variables set -p <projectId> -e <envId> \
#          --key AZURE_STORAGE_CONNECTION_STRING --value "..."
#      # ...repeat for each variable below
#      embr variables list -p <projectId> -e <envId>   # verify
#
# 2) Embr portal → Service → Variables tab
#
# 3) API (PATCH the service):
#
#      PATCH /projects/{projectId}/environments/{envId}/services/{svcId}
#      { "run": { "env": { "ELASTICSEARCH_URL": "https://...", ... } } }
#
# Use the values below as a copy-paste reference. Fill in real
# values for your environment before running the CLI commands.
#
# Auto-injected by Embr (do NOT set these manually — they come
# from `database.enabled` and `cache.enabled` in embr.yaml):
#   POSTGRES_URL    — injected by the managed Postgres broker
#   REDIS_URL       — injected by the managed Valkey broker
#
# NEVER commit real secrets. This file contains placeholders only.
# =============================================================


# -------------------------------------------------------------
# App settings
# -------------------------------------------------------------
APP_ENV=production

# Generate a strong random value:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_FROM_secrets.token_hex_32


# -------------------------------------------------------------
# Elasticsearch — Elastic Cloud on Azure (or Bonsai)
# Embr does NOT provide a managed Elasticsearch; bring your own.
# -------------------------------------------------------------
ELASTICSEARCH_URL=https://<deployment>.es.<region>.azure.elastic-cloud.com:9243

# Pick ONE auth method (API key preferred in production):
ES_API_KEY=<base64-api-key-from-the-elastic-cloud-ui>
# ES_USERNAME=elastic
# ES_PASSWORD=<your-password>


# -------------------------------------------------------------
# Azure Blob Storage — product images
# Embr does NOT provision storage accounts; bring your own.
# -------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<your-storage-account>;AccountKey=<your-storage-account-key>;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=product-images


# -------------------------------------------------------------
# RabbitMQ — CloudAMQP (Azure Marketplace) recommended
# Embr does NOT provide a managed message queue; bring your own.
# -------------------------------------------------------------
RABBITMQ_URL=amqps://<user>:<password>@<host>.cloudamqp.com/<vhost>


# -------------------------------------------------------------
# Managed by Embr — leave COMMENTED OUT, Embr injects these
# -------------------------------------------------------------
# POSTGRES_URL=<auto-injected by database.enabled: true>
# REDIS_URL=<auto-injected by cache.enabled: true>
